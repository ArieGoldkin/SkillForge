# =============================================================================
# SkillForge Development Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed for your environment.
# This file contains example values - NEVER commit your actual .env file!
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database (Main Application)
# -----------------------------------------------------------------------------
POSTGRES_USER=dev
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=skillforge

# -----------------------------------------------------------------------------
# Redis Configuration (Main Application)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your-redis-password-here

# -----------------------------------------------------------------------------
# PostgreSQL Database (Langfuse Observability)
# -----------------------------------------------------------------------------
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=your-langfuse-postgres-password-here
LANGFUSE_POSTGRES_DB=langfuse

# -----------------------------------------------------------------------------
# ClickHouse Database (Langfuse Analytics)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password-here

# -----------------------------------------------------------------------------
# MinIO S3 Storage (Langfuse Blob Storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=your-minio-access-key-here
MINIO_ROOT_PASSWORD=your-minio-secret-key-here

# -----------------------------------------------------------------------------
# Langfuse Security & Authentication
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your-32-character-nextauth-secret-here
NEXTAUTH_SALT=your-32-character-salt-here
LANGFUSE_ENCRYPTION_KEY=your-64-character-encryption-key-here
LANGFUSE_INIT_USER_PASSWORD=your-langfuse-admin-password-here

# -----------------------------------------------------------------------------
# Redis Configuration (Langfuse Services)
# -----------------------------------------------------------------------------
LANGFUSE_REDIS_PASSWORD=your-langfuse-redis-password-here

# =============================================================================
# Notes:
# - Generate secure random values for all passwords and secrets
# - Use at least 32 characters for NEXTAUTH_SECRET and salts
# - Use at least 64 characters for encryption keys
# - Never reuse passwords across different services
# =============================================================================
