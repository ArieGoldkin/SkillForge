# ============================================================================
# KEEP THESE FILES (Explicitly NOT ignored)
# ============================================================================

# Keep example environment files
!.env.example
!backend/.env.example
!frontend/.env.example

# Keep README files
!README.md
!*/README.md

# Keep documentation
!docs/**
!*.md

# Keep Alembic migrations (these should be in git)
!alembic/versions/*.py

# Keep Docker files
!Dockerfile
!docker-compose.yml
!.dockerignore

# Keep CI/CD configs
!.github/
!.github/workflows/

# Keep config files
!.eslintrc.*
!.prettierrc.*
!tsconfig.json
!vite.config.ts
!tailwind.config.js
!alembic.ini
