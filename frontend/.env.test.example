# Frontend Test Environment Configuration
# Copy this file to .env.test and fill in your credentials
# cp .env.test.example .env.test

# API Configuration
# Backend API URL for test environment (port 8501)
VITE_API_BASE_URL=http://localhost:8501

# Langfuse Configuration (for E2E tests)
# Langfuse UI URL for test environment (port 3001)
LANGFUSE_URL=http://localhost:3001

# Langfuse Authentication Credentials
# MUST be set - these are used by E2E tests that interact with Langfuse UI
# Get these from your Langfuse test instance
LANGFUSE_EMAIL=your-email@example.com
LANGFUSE_PASSWORD=your-password-here

# E2E Test Configuration
# Frontend base URL for Playwright tests (port 5174)
E2E_BASE_URL=http://localhost:5174

# API base URL for Playwright tests (port 8501)
API_BASE_URL=http://localhost:8501

# Playwright base URL (same as E2E_BASE_URL)
PLAYWRIGHT_BASE_URL=http://localhost:5174
