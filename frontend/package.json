{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build:analyze": "tsc -b tsconfig.app.json tsconfig.node.json && vite build --mode analyze",
    "build:check-size": "node scripts/check-bundle-size.js",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "biome format --write src",
    "format:check": "biome check src",
    "typecheck": "tsc --noEmit",
    "quality:check": "npm run lint && npm run format:check && npm run typecheck",
    "quality:fix": "npm run lint:fix && npm run format",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest run --reporter=verbose",
    "test:unit": "vitest run --testNamePattern=\"@unit\"",
    "test:integration:unit": "vitest run --testNamePattern=\"@integration\"",
    "test:component-e2e": "E2E_READY=true vitest run --testNamePattern=\"@component-e2e\"",
    "test:ci": "vitest run --testNamePattern=\"@ci\" --coverage",
    "test:slow": "vitest run --testNamePattern=\"@slow\"",
    "test:performance": "RUN_PERFORMANCE_TESTS=true vitest run --testNamePattern=\"@slow\"",
    "test:flaky": "vitest run --retry=3 --testNamePattern=\"@flaky\"",
    "test:dev": "vitest run --grep \"@dev\"",
    "test:critical": "vitest run --grep \"@critical\"",
    "e2e:playwright": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:vrt": "playwright test e2e/specs/visual-regression.spec.ts --project=chromium",
    "e2e:report": "playwright show-report",
    "test:env:up": "docker compose -f docker-compose.test.yml up -d",
    "test:env:down": "docker compose -f docker-compose.test.yml down",
    "test:env:logs": "docker compose -f docker-compose.test.yml logs -f",
    "test:env:restart": "docker compose -f docker-compose.test.yml restart",
    "test:e2e": "./scripts/run-e2e-tests.sh",
    "test:e2e:direct": "PLAYWRIGHT_BASE_URL=http://localhost:5174 API_BASE_URL=http://localhost:8501 LANGFUSE_URL=http://localhost:3001 playwright test --project=chromium",
    "test:integration": "./scripts/run-e2e-tests.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.142.8",
    "@tanstack/react-virtual": "^3.13.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "ky": "^1.14.2",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-scan": "^0.4.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-onboarding": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/router-plugin": "^1.142.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.13",
    "@vitest/coverage-v8": "^4.0.13",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "eslint-plugin-storybook": "^10.1.10",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.4",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^10.1.10",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.13",
    "vitest-react-profiler": "^1.12.0"
  }
}
