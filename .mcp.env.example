# MCP Server Environment Variables for SkillForge
#
# 🔒 SECURITY: Copy this file to .mcp.env and fill in your actual values
# .mcp.env is gitignored - NEVER commit your secrets!
#
# Setup:
#   cp .mcp.env.example .mcp.env
#   # Edit .mcp.env with your actual API keys and credentials
#
# Type: Project-specific MCP configuration
# Scope: SkillForge project only
# Never reuse keys across projects or environments

# ============================================================================
# PostgreSQL Database URLs
# ============================================================================

# Development Database URL (full URL with database name)
# Used by: skillforge-postgres-dev MCP server
# Type: postgresql:// connection string
# Scope: Local development only - never use in production
# Format: postgresql://user:password@host:port/database
# NOTE: Default values match docker-compose.yml configuration (port 5437)
POSTGRES_URL_DEV=postgresql://dev:devpass@localhost:5437/skillforge

# Test Database Base URL (base URL without database name)
# Used by: postgres-test MCP server (if configured)
# Type: postgresql:// connection string (without database name)
# Scope: Local testing only - isolated from dev/staging/prod
# Format: postgresql://user:password@host:port
# Note: Connects to 'postgres' database by default, allowing cross-database queries using fully qualified names (database.schema.table)
# NOTE: Test database not yet configured - update when test DB is set up
# POSTGRES_URL_TEST=postgresql://test_user:test_password@localhost:5438

# Staging Database URL (full URL with database name)
# Used by: postgres-staging MCP server (if configured)
# Type: postgresql:// connection string
# Scope: Staging environment only
# Format: postgresql://user:password@host:port/database
# POSTGRES_URL_STAGING=postgresql://staging_user:staging_password@staging-host:5432/skillforge_staging

# Production Database URL (full URL with database name)
# Used by: postgres-prod MCP server (if configured)
# Type: postgresql:// connection string
# Scope: Production environment only - EXTREME CAUTION
# Format: postgresql://user:password@host:port/database
# ⚠️  WARNING: Never commit production credentials!
# POSTGRES_URL_PROD=postgresql://prod_user:prod_password@prod-host:5432/skillforge

# ============================================================================
# External Service API Keys
# ============================================================================

# LangSmith API Key
# Used by: skillforge-langsmith MCP server
# Type: API key string (starts with lsv2_pt_...)
# Scope: LangSmith observability for SkillForge project
# Where to get: https://smith.langchain.com/settings
# Note: Also requires LANGSMITH_PROJECT environment variable (set in .cursor/mcp.json)
LANGSMITH_API_KEY=your_langsmith_api_key_here

# ============================================================================
# Optional: Context7 API Key (for higher rate limits)
# ============================================================================
# CONTEXT7_API_KEY=your_context7_api_key_here
# Where to get: https://context7.com (if using paid tier)

# ============================================================================
# Environment Selection
# ============================================================================
# The wrapper scripts use MCP_ENV to select the appropriate database URL
# Default: dev (if not set)
# Valid values: dev, test, staging, prod
# MCP_ENV=dev

