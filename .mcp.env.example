# MCP Server Environment Variables Template
# Copy this file to .mcp.env and fill in your values
# DO NOT commit .mcp.env - it contains sensitive credentials

# PostgreSQL Connection (for postgres-mcp)
# These should match your docker-compose.yml or local database setup
POSTGRES_USER=dev
POSTGRES_PASSWORD=devpass
POSTGRES_DB=skillforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5437
POSTGRES_CONNECTION_STRING=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Langfuse Configuration (for langfuse MCP)
# Get these from http://localhost:3000/settings after starting Langfuse
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
