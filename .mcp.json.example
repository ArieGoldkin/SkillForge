{
  "$schema": "https://modelcontextprotocol.io/schema.json",
  "mcpServers": {
    "memory": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-memory"]
    },
    "sequential-thinking": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "context7": {
      "command": "pnpm",
      "args": ["dlx", "@upstash/context7-mcp@latest"]
    },
    "pg-aiguide": {
      "type": "http",
      "url": "https://mcp.tigerdata.com/docs"
    },
    "postgres-mcp": {
      "command": "pnpm",
      "args": ["dlx", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_CONNECTION_STRING": "${POSTGRES_CONNECTION_STRING}"
      }
    },
    "playwright": {
      "command": "pnpm",
      "args": ["dlx", "@playwright/mcp@latest"]
    },
    "langfuse": {
      "command": "pnpm",
      "args": ["dlx", "langfuse-mcp"],
      "env": {
        "LANGFUSE_HOST": "${LANGFUSE_HOST}",
        "LANGFUSE_PUBLIC_KEY": "${LANGFUSE_PUBLIC_KEY}",
        "LANGFUSE_SECRET_KEY": "${LANGFUSE_SECRET_KEY}"
      }
    }
  }
}
