        "Split work across multiple workers",
        "Aggregate parallel results"
      ],
      "reference_file": "SKILL.md#pattern-1-map-reduce-parallel-agents",
      "token_cost": 120
    },
    "human-in-loop": {
      "keywords": ["human review", "interrupt", "approval", "manual review", "pause workflow"],
