{
  "$schema": "../../schemas/skill-capabilities.schema.json",
  "name": "code-review-playbook",
  "version": "1.0.0",
  "description": "Structured review processes, conventional comments, language-specific checklists, and feedback templates",

  "capabilities": {
    "review-process": {
      "keywords": ["code review", "pr review", "review process", "review checklist"],
      "solves": [
        "How do I review this PR?",
        "Code review best practices",
        "What to look for in reviews"
      ],
      "reference_file": "SKILL.md#review-process",
      "token_cost": 150
    },
    "conventional-comments": {
      "keywords": ["conventional comments", "feedback", "suggestion", "nitpick", "blocking"],
      "solves": [
        "How do I write review comments?",
        "Conventional comments format",
        "Constructive feedback patterns"
      ],
      "reference_file": "SKILL.md#conventional-comments",
      "token_cost": 100
    },
    "typescript-review": {
      "keywords": ["typescript review", "type check", "strict mode", "any types"],
      "solves": [
        "Review TypeScript code",
        "Check for type safety issues",
        "TypeScript-specific patterns"
      ],
      "checklist_file": "checklists/typescript-review.md",
      "token_cost": 120
    },
    "python-review": {
      "keywords": ["python review", "pep8", "type hints", "pythonic"],
      "solves": [
        "Review Python code",
        "Check PEP8 compliance",
        "Python best practices"
      ],
      "checklist_file": "checklists/python-review.md",
      "token_cost": 120
    },
    "security-review": {
      "keywords": ["security review", "vulnerability", "injection", "xss"],
      "solves": [
        "Review for security issues",
        "Identify vulnerabilities",
        "Security-focused review"
      ],
      "checklist_file": "checklists/security-review.md",
      "token_cost": 150
    }
  },

  "triggers": {
    "high_confidence": ["review.*code", "pr.*review", "check.*this", "feedback.*on"],
    "medium_confidence": ["look.*at", "what.*think", "review"]
  },

  "integrates_with": ["security-checklist", "testing-strategy-builder", "evidence-verification"],

  "progressive_loading": {
    "tier_1_discovery": { "file": "capabilities.json", "tokens": 100 },
    "tier_2_overview": { "file": "SKILL.md", "tokens": 400, "sections": ["overview", "review-philosophy"] },
    "tier_3_specific": { "files": "checklists/*.md", "tokens": "100-150 each" }
  },

  "mcp_tools": {
    "diagnostics": { "tool": "ide", "use_when": "Need IDE diagnostics for review" }
  }
}
