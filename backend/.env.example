# =============================================================================
# SkillForge Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed for your environment.
# Never commit .env files to version control (they are in .gitignore).
#
# Pydantic Settings will automatically load variables from .env file.
# For list types (like CORS_ORIGINS), use JSON array format or comma-separated.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Runtime environment: development, staging, or production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# SECURITY: DEBUG level can expose sensitive information in logs
# Use INFO or higher in production
LOG_LEVEL=INFO

# API prefix for all v1 endpoints
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Server host address
#   - 127.0.0.1: Only local connections (default, secure)
#   - 0.0.0.0: Allows external connections (use only in trusted networks)
# SECURITY: Never use 0.0.0.0 in production without proper firewall rules
HOST=127.0.0.1

# Server port
PORT=8500

# Enable auto-reload on code changes
# SECURITY: Must be false in production (security risk if enabled)
RELOAD=false

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed CORS origins (JSON array format)
# 
# SECURITY: Never use ["*"] in production! Always specify exact origins.
# For development, localhost is acceptable:
#   CORS_ORIGINS=["http://localhost:5173"]
# 
# For production, use your actual frontend URL(s):
#   CORS_ORIGINS=["https://app.example.com","https://www.example.com"]
# 
# Example: CORS_ORIGINS=["http://localhost:5173","https://app.example.com"]
CORS_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string (required in production)
# Format: postgresql://user:password@host:port/database
# 
# SECURITY: Never use weak passwords like "devpass" in production!
# Use strong, randomly generated passwords for production databases.
# 
# For development with Docker Compose, use:
# DATABASE_URL=postgresql://dev:devpass@localhost:5437/skillforge
#
# For production, use a secure connection string:
# DATABASE_URL=postgresql://username:STRONG_PASSWORD@host:port/database
DATABASE_URL=

# -----------------------------------------------------------------------------
# Multi-Provider LLM Configuration
# -----------------------------------------------------------------------------
# Primary LLM identifier. Supports (November 24, 2025 - Verified):
#   - OpenAI (GPT-5, GPT-5 Mini, GPT-5 Nano, GPT-4.1, GPT-4o, GPT-5.1 Codex variants)
#   - Anthropic (Claude 4 Sonnet, Claude 4 Opus, Claude 3.5 Haiku)
#   - Google Gemini (Gemini 2.0 Flash, Gemini 2.5 Flash/Pro)
#   - xAI (Grok 3 Mini, Grok 3 Std)
#   - DeepSeek (V3.2-Exp with cache support)
#   - Experimental providers (Composer 1, Kimi K2) when custom LangChain integrations are installed
#
# Cost Comparison (per 1M tokens, November 24, 2025 - Verified):
#   Provider        | Model              | Input  | Output | Tool Calling | Best For
#   ----------------+--------------------+--------+--------+--------------+------------------
#   DeepSeek        | v3.2-exp (cache)   | $0.028 | $0.42  | ✅ Full      | Cheapest (cache hit)
#   DeepSeek        | v3.2-exp           | $0.28  | $0.42  | ✅ Full      | Very cheap
#   Google          | gemini-2.0-flash   | $0.075 | $0.30  | ✅ Full      | CHEAPEST INPUT
#   OpenAI          | gpt-5-nano         | $0.05  | $0.40  | ✅ Enhanced  | Cheapest OpenAI
#   OpenAI          | gpt-5-mini          | $0.25  | $2.00  | ✅ Enhanced  | RECOMMENDED: Latest + cheap
#   xAI             | grok-3-mini        | $0.30  | $0.50  | ✅ Full      | Very cheap
#   OpenAI          | gpt-4o-mini        | $0.60  | $2.40  | ✅ Full      | Established (more expensive than GPT-5 Mini!)
#   Google          | gemini-2.5-flash   | $0.15  | $3.50  | ✅ Full      | Fast, large context
#   OpenAI          | gpt-5              | $1.25  | $10.00 | ✅ Enhanced  | Latest standard (5x more than mini)
#   Google          | gemini-2.5-pro     | $1.25  | $10.00 | ✅ Full      | Quality balance
#   OpenAI          | gpt-4.1            | $3.00  | $12.00 | ✅ Full      | Enhanced GPT-4
#   Anthropic       | claude-sonnet-4    | $3.00  | $15.00 | ✅ Full      | Strong reasoning
#   xAI             | grok-3-std         | $3.00  | $15.00 | ✅ Full      | Alternative
#   OpenAI          | gpt-4o             | $5.00  | $20.00 | ✅ Full      | Vision support
#   Anthropic       | claude-opus-4-5    | $5.00  | $25.00 | ✅ Full      | BEST FOR AGENTS: 48-76% fewer tokens!
#   Anthropic       | claude-opus-4.1    | $15.00 | $75.00 | ✅ Full      | Best reasoning (most expensive, deprecated)
#
# Recommendations (November 24, 2025 - Verified):
#   - Development (RECOMMENDED): Use GPT-5 Mini - LLM_MODEL=gpt-5-mini ($0.25/$2.00)
#   - Production (RECOMMENDED): Use GPT-5 Mini - LLM_MODEL=gpt-5-mini ($0.25/$2.00)
#     → Newer model, cheaper than GPT-4o Mini, enhanced tool calling
#   - Production (cheapest input): Use Gemini 2.0 Flash - LLM_MODEL=gemini-2.0-flash ($0.075/$0.30)
#   - Production (cheapest overall): Use DeepSeek V3.2 - LLM_MODEL=deepseek-v3.2 ($0.28/$0.42, cache hit: $0.028/$0.42)
#   - Production (budget OpenAI): Use GPT-5 Nano - LLM_MODEL=gpt-5-nano ($0.05/$0.40)
#   - Production (quality): Use GPT-5 - LLM_MODEL=gpt-5 ($1.25/$10.00, 5x more than mini)
#   - Production (reasoning): Use Claude 4 Sonnet - LLM_MODEL=claude-sonnet-4 ($3.00/$15.00)
#   - Production (AGENTS - RECOMMENDED): Use Claude Opus 4.5 - LLM_MODEL=claude-opus-4-5-20251101 ($5/$25, but 48-76% fewer tokens = actually cheaper!)
#   - Production (coding): Use GPT-5.1-Codex - LLM_MODEL=gpt-5.1-codex (coding optimized)
#
# Why NOT use GPT-5 standard by default:
#   - GPT-5 ($1.25/$10.00) is 5x more expensive than GPT-5 Mini ($0.25/$2.00)
#   - GPT-5 Mini provides same enhanced tool calling at much lower cost
#   - Only use GPT-5 when maximum quality/reasoning is required
#
# Format options (November 24, 2025 - Verified):
#   LLM_MODEL=gpt-5-mini                 # $0.25/$2.00 - RECOMMENDED: Latest + cheap
#   LLM_MODEL=gpt-5-nano                 # $0.05/$0.40 - Cheapest OpenAI
#   LLM_MODEL=gemini-2.0-flash           # $0.075/$0.30 - CHEAPEST INPUT
#   LLM_MODEL=deepseek-v3.2              # $0.28/$0.42 - Very cheap (cache: $0.028/$0.42)
#   LLM_MODEL=grok-3-mini                # $0.30/$0.50 - Very cheap alternative
#   LLM_MODEL=gpt-5                      # $1.25/$10.00 - Latest standard (5x more than mini)
#   LLM_MODEL=claude-sonnet-4            # $3.00/$15.00 - Strong reasoning
#   LLM_MODEL=claude-opus-4-5-20251101   # $5/$25 - BEST FOR AGENTS: 48-76% fewer tokens, better quality
#   LLM_MODEL=claude-opus-4.1            # $15.00/$75.00 - Best reasoning (deprecated, use Opus 4.5 instead)
#   LLM_MODEL=openai/gpt-5-mini          # explicit provider via slash
#   LLM_MODEL=xai/grok-3-mini            # explicit provider for Grok
#
# Optional override if inference is insufficient:
#   LLM_PROVIDER=openai | anthropic | google_genai | xai | deepseek | ...
LLM_MODEL=gpt-5-mini
# LLM_PROVIDER=

# LLM Model Parameters (optional - defaults to provider defaults):
#   LLM_TEMPERATURE=0.7          # 0.0-2.0: Lower = deterministic, higher = creative
#   LLM_MAX_TOKENS=2000          # Maximum response tokens (None = provider default)
#   LLM_TIMEOUT=30.0             # API call timeout in seconds (None = provider default)
#   LLM_RETRY_DELAY_BASE=1.0     # Base delay for retry exponential backoff (1.0 = 1s/2s/4s, 0.1 = 0.1s/0.2s/0.4s)

# Provider API keys (set the ones that match your provider)
# OpenAI API key (required for GPT-5, GPT-5 Mini, GPT-4o, etc.)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic API key (required for Claude 4 Sonnet, Claude 4 Opus, etc.)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Google API key (required for Gemini 2.0 Flash, Gemini 2.5 Pro, etc.)
# Get your key at: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=...

# xAI API key (required for Grok 3 Mini, Grok 3 Std, etc.)
# Get your key at: https://x.ai
# XAI_API_KEY=...

# DeepSeek API key (required for DeepSeek V3.2, etc.)
# Get your key at: https://deepseek.com
# DEEPSEEK_API_KEY=...

# Embedding Configuration (OpenAI)
# Expected embedding dimensions (matches model output)
# 1536 for OpenAI text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Content Extraction Configuration
# -----------------------------------------------------------------------------
# Jina AI API key for content extraction (optional for dev)
# Get free key at: https://jina.ai
# 
# IMPORTANT: Add your API key here to enable the integration test
# (test_extract_article_real_api). The test automatically reads from .env via
# the Settings system. If not set, the integration test is skipped.
# Leave empty for development if not using Jina AI
JINA_API_KEY=
