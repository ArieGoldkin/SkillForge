{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillForge Evaluation Dataset v2.0",
  "description": "Schema for evaluation datasets with provenance tracking, validation status, and scoring rubrics",
  "type": "object",
  "required": ["version", "metadata", "examples"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^2\\.\\d+\\.\\d+$",
      "description": "Semantic version (2.x.x for v2 schema)"
    },
    "metadata": {
      "type": "object",
      "required": ["dataset_name", "task_type", "created_at", "agent_types"],
      "properties": {
        "dataset_name": {
          "type": "string",
          "description": "Human-readable dataset identifier"
        },
        "task_type": {
          "type": "string",
          "enum": ["supervisor", "agent", "synthesis", "edge_case"],
          "description": "Type of LangGraph task this dataset evaluates"
        },
        "agent_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tech_comparator",
              "security_auditor",
              "implementation_planner",
              "integration_specialist",
              "performance_optimizer",
              "content_quality_analyst",
              "dependency_auditor",
              "code_reviewer"
            ]
          },
          "description": "Agent types covered in this dataset"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Technical domains covered (e.g., 'web-dev', 'ml', 'devops')"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "release_tag": {
          "type": "string",
          "description": "Git tag or release identifier (e.g., 'v2.1.0', 'sprint-8')"
        },
        "description": {
          "type": "string"
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "inputs", "expected_outputs", "evaluation_criteria", "provenance"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique example identifier (e.g., 'agent-tech-001')"
          },
          "inputs": {
            "type": "object",
            "required": ["content", "content_type"],
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1,
                "description": "Raw content to analyze (minLength 1 to allow edge case testing)"
              },
              "content_type": {
                "type": "string",
                "enum": ["article", "tutorial", "video_transcript", "documentation", "code_repository", "query"],
                "description": "Type of content"
              },
              "agent_type": {
                "type": "string",
                "description": "Specific agent to test (for agent task type)"
              },
              "analysis_id": {
                "type": "string",
                "description": "Optional analysis ID for tracking"
              },
              "metadata": {
                "type": "object",
                "description": "Additional input context"
              }
            }
          },
          "expected_outputs": {
            "type": "object",
            "required": ["primary"],
            "properties": {
              "primary": {
                "type": "object",
                "description": "Main expected output structure (varies by task type)"
              },
              "acceptable_alternatives": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "Alternative valid outputs (for partial credit)"
              },
              "forbidden_outputs": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "Outputs that indicate failure"
              }
            }
          },
          "evaluation_criteria": {
            "type": "object",
            "required": ["scoring_rubric"],
            "properties": {
              "scoring_rubric": {
                "type": "object",
                "required": ["correctness", "completeness", "quality"],
                "properties": {
                  "correctness": {
                    "type": "object",
                    "required": ["weight", "thresholds"],
                    "properties": {
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "thresholds": {
                        "type": "object",
                        "required": ["perfect", "acceptable", "failing"],
                        "properties": {
                          "perfect": {
                            "type": "number",
                            "minimum": 0.9,
                            "maximum": 1.0
                          },
                          "acceptable": {
                            "type": "number",
                            "minimum": 0.5,
                            "maximum": 0.9
                          },
                          "failing": {
                            "type": "number",
                            "maximum": 0.7
                          }
                        }
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  },
                  "completeness": {
                    "type": "object",
                    "required": ["weight", "required_fields"],
                    "properties": {
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "required_fields": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "List of required output fields"
                      },
                      "optional_fields": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "quality": {
                    "type": "object",
                    "required": ["weight", "min_length", "max_length"],
                    "properties": {
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "min_length": {
                        "type": "integer",
                        "description": "Minimum character count for text outputs"
                      },
                      "max_length": {
                        "type": "integer",
                        "description": "Maximum character count (prevents verbosity)"
                      },
                      "keywords": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Expected keywords/concepts in output"
                      }
                    }
                  },
                  "latency": {
                    "type": "object",
                    "properties": {
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "target_p95_ms": {
                        "type": "integer",
                        "description": "Target p95 latency in milliseconds"
                      }
                    }
                  },
                  "cost": {
                    "type": "object",
                    "properties": {
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "max_cost_usd": {
                        "type": "number",
                        "description": "Maximum acceptable cost per example"
                      }
                    }
                  }
                }
              },
              "custom_evaluators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": ["llm_judge", "regex", "semantic_similarity", "custom_function"]
                    },
                    "config": {
                      "type": "object"
                    }
                  }
                },
                "description": "Custom evaluator configurations for this example"
              }
            }
          },
          "provenance": {
            "type": "object",
            "required": ["source", "created_at"],
            "properties": {
              "source": {
                "type": "string",
                "enum": ["synthetic", "langsmith", "github", "arxiv", "production", "human_crafted"],
                "description": "Origin of this example"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "created_by": {
                "type": "string",
                "description": "Username or system that created this example"
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "description": "URL to original source (for langsmith/github/arxiv)"
              },
              "langsmith_trace_id": {
                "type": "string",
                "description": "LangSmith trace ID if sourced from production traces"
              },
              "github_issue_url": {
                "type": "string",
                "format": "uri",
                "description": "GitHub issue URL if sourced from bug reports"
              },
              "arxiv_id": {
                "type": "string",
                "pattern": "^\\d{4}\\.\\d{4,5}$",
                "description": "arXiv paper ID if sourced from research papers"
              },
              "notes": {
                "type": "string",
                "description": "Additional provenance notes"
              }
            }
          },
          "validation": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["draft", "pending_review", "validated", "rejected", "needs_update"],
                "description": "Current validation status"
              },
              "validated_by": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["reviewer", "validated_at", "approved"],
                  "properties": {
                    "reviewer": {
                      "type": "string"
                    },
                    "validated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "approved": {
                      "type": "boolean"
                    },
                    "comments": {
                      "type": "string"
                    }
                  }
                }
              },
              "quality_score": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1,
                "description": "Human-assigned quality score (0-1), null for draft examples"
              }
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "difficulty": {
                "type": "string",
                "enum": ["easy", "medium", "hard", "expert", "adversarial"],
                "description": "Difficulty level for the model"
              },
              "edge_case": {
                "type": "boolean",
                "description": "True if this is an edge case example"
              },
              "adversarial": {
                "type": "boolean",
                "description": "True if this is an adversarial example (tests robustness)"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Freeform tags for categorization"
              },
              "notes": {
                "type": "string",
                "description": "Additional notes about this example"
              },
              "related_examples": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of related examples"
              }
            }
          }
        }
      }
    }
  }
}
