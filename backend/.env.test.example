# =============================================================================
# SkillForge Backend - Test Environment Configuration
# =============================================================================
# Copy this file to .env.test and update with your real API keys for integration tests.
# Never commit .env.test files to version control (they are in .gitignore).
#
# This file should contain the SAME values as your .env file, but specifically
# for running integration tests that require real API keys.
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=skillforge-test

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=redis-dev

# =============================================================================
# LLM API Keys (Required for full workflow testing)
# =============================================================================
# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google GenAI API Key - Get from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# xAI API Key (optional) - Get from https://console.x.ai/
XAI_API_KEY=your-xai-api-key-here

# DeepSeek API Key (optional) - Get from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# =============================================================================
# Content Extraction API Keys
# =============================================================================
# Jina API Key (required for content extraction) - Get from https://jina.ai
JINA_API_KEY=your-jina-api-key-here

# =============================================================================
# Langfuse Observability (Test Environment)
# =============================================================================
# Langfuse API Keys - Get these from your test Langfuse instance
# (Accessible at http://localhost:3001 after starting test environment)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_ENABLED=true

# Langfuse Database Configuration
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_POSTGRES_DB=langfuse

# Langfuse Redis Configuration
LANGFUSE_REDIS_PASSWORD=redis-dev

# Clickhouse Configuration
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=langfuse

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =============================================================================
# Application Configuration
# =============================================================================
# LLM Model (use cost-efficient model for testing)
LLM_MODEL=gpt-4o-mini

# Environment
ENVIRONMENT=test

# Log Level
LOG_LEVEL=INFO

# =============================================================================
# Security (Test Environment - Change in production!)
# =============================================================================
NEXTAUTH_SECRET=test-secret-change-in-production
NEXTAUTH_SALT=test-salt-change-in-production
LANGFUSE_ENCRYPTION_KEY=test-key-change-in-production
LANGFUSE_INIT_USER_PASSWORD=test

# =============================================================================
# Workflow Control
# =============================================================================
# Set to "true" to disable workflows for lightweight/cost-free tests
# Set to "false" or remove to enable full LLM workflows (requires API keys above)
SKILLFORGE_E2E_DISABLE_WORKFLOW=false
