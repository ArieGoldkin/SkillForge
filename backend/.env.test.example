# =============================================================================
# SkillForge Backend - Test Environment Configuration
# =============================================================================
# Copy this file to .env.test and update with your real API keys for integration tests.
# Never commit .env.test files to version control (they are in .gitignore).
#
# This file should contain the SAME values as your .env file, but specifically
# for running integration tests that require real API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings (Test Environment)
# -----------------------------------------------------------------------------
ENVIRONMENT=testing
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Server Configuration (Test)
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8500
RELOAD=false

# -----------------------------------------------------------------------------
# CORS Configuration (Test)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Database Configuration (Test)
# -----------------------------------------------------------------------------
# Use test database (separate from dev database)
DATABASE_URL=postgresql://dev:devpass@localhost:5437/skillforge_test

# -----------------------------------------------------------------------------
# Ollama LLM Configuration (Test)
# -----------------------------------------------------------------------------
# Should match your .env values for real API testing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# Content Extraction Configuration (Test)
# -----------------------------------------------------------------------------
# IMPORTANT: Use your REAL Jina AI API key here for integration tests
# Get free key at: https://jina.ai
# This should be the SAME key as in your .env file
JINA_API_KEY=your_real_jina_api_key_here
